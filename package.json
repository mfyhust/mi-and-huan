{
  "name": "xunhui-campus-agent",
  "version": "1.2.0-rc.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "dev:api": "node scripts/start-edition.mjs api",
    "dev:local": "node scripts/start-edition.mjs local",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node tests/run.mjs",
    "test:d1": "node --import ./scripts/sites-env.mjs tests/d1-runtime.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test && npm run typecheck",
    "db:local": "node scripts/migrate-local.mjs",
    "configure:sjtu": "node scripts/configure-sjtu-local.mjs",
    "test:live": "python3 scripts/check-local-agent.py --run-model-tests",
    "build:offline": "vite build --config vite.offline.config.ts",
    "start:offline": "node offline/server.mjs",
    "offline:check": "node offline/check.mjs",
    "test:offline": "node tests/offline-runtime.test.mjs",
    "eval:offline": "node evals/run-offline.mjs",
    "eval:local-model": "node evals/run-local-model.mjs",
    "eval:adapter-agent": "node evals/run-adapter-agent.mjs",
    "eval:disconnected": "node evals/run-disconnected.mjs",
    "training:prepare": "node training/prepare-examples.mjs",
    "eval:matching": "node evals/run-matching-quality.mjs",
    "build:api-static": "vite build --config vite.api.config.ts",
    "start:api": "node api/server.mjs",
    "start:demo": "node remote/server.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
